# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# runtime caches written by the server
sic-cache.json
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# version-control baseline additions (Stage 2 cleanup)
dist/
*.log
.env.*
# NOTE: _archive/ is intentionally TRACKED — archiving (vs deleting) is meant to
# preserve the file; version control is the durable place to keep it.
.env
../outreach/

# unattended sweep harness — transient run artifacts + the stop sentinel (agent/
# calibration.csv and agent/DECISIONS.md are the durable audit record and stay TRACKED)
agent/runs/
agent/STOP

# sweep dashboard runtime log (written by open-dashboard.sh)
agent/dashboard/dashboard.log

# sweep dashboard working-queue state (paste-replaces; not the harness QUEUE.md)
agent/dashboard/plan.json

# pre-demo run-through artifacts (scripts/runthrough.mjs) — transient, like agent/runs/
scripts/.runthrough/

# Claude Code preview-pane launch config — machine-local, written by the app, not project config
.claude/launch.json
